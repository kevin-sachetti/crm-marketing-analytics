	column 'Anos de Associacao' = DATEDIFF(associados[data_associacao], DATE(2025, 9, 30), DAY) / 365.25
		lineageTag: 944755e3-8a67-4db6-afd5-cdd8cca88a82
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Faixa Tempo de Associacao' =
			
			SWITCH(
			    TRUE(),
			    associados[Anos de Associacao] <= 1, "Até 1 ano",
			    associados[Anos de Associacao] <= 2, "1 a 2 anos",
			    associados[Anos de Associacao] <= 4, "2 a 4 anos",
			    "4 anos ou mais"
			)
		lineageTag: d413ab3a-c049-4b75-b9fa-43cb16050135
		summarizeBy: none
		sortByColumn: 'Ordem Faixa Tempo'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Categoria NPS' =
			
			SWITCH(
			    TRUE(),
			    associados[nps_score] >= 9, "Promotor",
			    associados[nps_score] >= 7, "Neutro",
			    "Detrator"
			)
		lineageTag: bf4cf4e8-262c-48e8-99fd-70842304994d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Ordem Faixa Tempo' =
			
			SWITCH(
			    TRUE(),
			    associados[Anos de Associacao] <= 1, 1,
			    associados[Anos de Associacao] <= 2, 2,
			    associados[Anos de Associacao] <= 4, 3,
			    4
			)
		formatString: 0
		lineageTag: 9cdde72d-7064-4fb4-ac68-2380b3676f26
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Ano de Associacao' = YEAR(associados[data_associacao])
		formatString: 0
		lineageTag: 1419ca62-0fb5-45a2-85ea-359e827832aa
		summarizeBy: none

	column 'Mes de Associacao' = DATE(YEAR(associados[data_associacao]), MONTH(associados[data_associacao]), 1)
		formatString: mm/yyyy
		lineageTag: 1658f3a4-8828-483c-a849-42427b381b56
		summarizeBy: none

