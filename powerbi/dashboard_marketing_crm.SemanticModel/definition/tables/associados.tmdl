table associados
	lineageTag: a6363fec-4338-45c4-a075-8c6296be2538

	measure 'Total Associados' = COUNTROWS(associados)
		formatString: #,0
		lineageTag: b1f5ab07-425f-41d8-955e-9401cd1c61d8

	measure Ativos = CALCULATE([Total Associados], associados[status] = "Ativo")
		formatString: #,0
		lineageTag: c7f5b16b-6cf5-4863-82d5-e0b7e8d9a5f2

	measure '% Ativos' = DIVIDE([Ativos], [Total Associados])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2aae0e59-51ab-4366-8828-6752b17adb36

	measure Churned = CALCULATE([Total Associados], associados[status] = "Churned")
		formatString: #,0
		lineageTag: befce1e9-b3d7-414d-aae4-13c1b312771e

	measure 'Taxa de Churn' = DIVIDE([Churned], [Total Associados])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c39937d0-de1d-4180-9d90-b796be086286

	measure '% Promotores' = DIVIDE(CALCULATE([Total Associados], associados[nps_score] >= 9), [Total Associados])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5ebc7982-1d2f-46c8-a1e4-d64c0f774004

	measure '% Detratores' = DIVIDE(CALCULATE([Total Associados], associados[nps_score] <= 6), [Total Associados])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a92f0ca2-4b68-444d-86c6-5ace5b6c5153

	measure NPS = ([% Promotores] - [% Detratores]) * 100
		formatString: 0.0
		lineageTag: 2d8bfbf4-96d5-45cd-b750-942957ae5454

	measure 'Média de Produtos' = AVERAGE(associados[qtd_produtos])
		formatString: 0.00
		lineageTag: 2629b0a8-e3a7-4a56-ac58-8571342116f4

	measure 'Taxa de Abertura' = DIVIDE(SUM(associados[campanhas_abertas]), SUM(associados[campanhas_recebidas]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3c84f8e1-2296-4539-b06a-7af29e2781ac

	measure 'Taxa de Conversão' = DIVIDE(SUM(associados[campanhas_convertidas]), SUM(associados[campanhas_abertas]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f8283972-0ab6-4160-b4bb-83c90479f8ce

	measure 'Saldo Médio CC' = CALCULATE(AVERAGE(associados[saldo_medio_cc]), associados[tem_conta_corrente] = 1)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: fbc41b22-1c7f-4075-a95e-7dca6edea40b

	measure 'Oportunidade Cartão' = CALCULATE([Total Associados], associados[status] = "Ativo", associados[tem_conta_corrente] = 1, associados[tem_cartao_credito] = 0)
		formatString: #,0
		lineageTag: 1447320b-5ad7-4f1c-a975-6c041f88f3a3

	measure 'Idade Média' = AVERAGE(associados[idade])
		formatString: 0.0
		lineageTag: 97ab5087-f11f-4c29-a35d-5f19c3eeff0b

	measure 'Nota NPS Média' = AVERAGE(associados[nps_score])
		formatString: 0.00
		lineageTag: 8480e294-5f42-4810-8725-d54304598806

	measure 'Transações Médias' = AVERAGE(associados[transacoes_ultimo_trimestre])
		formatString: 0.0
		lineageTag: b9362547-465c-4efd-be30-cacd2a4f8c4d

	measure 'Dias sem Acesso Médio' = AVERAGE(associados[dias_desde_ultimo_acesso])
		formatString: 0.0
		lineageTag: d97bd5e5-01b7-43cb-8eb5-47e5e52d12c2

	measure 'Campanhas Recebidas' = SUM(associados[campanhas_recebidas])
		formatString: #,0
		lineageTag: 68495dad-726a-4d32-bace-e7c1ab03db00

	measure 'Campanhas Abertas' = SUM(associados[campanhas_abertas])
		formatString: #,0
		lineageTag: 9331bccf-b27a-4192-a7be-9f7ed8bfea5e

	measure 'Campanhas Convertidas' = SUM(associados[campanhas_convertidas])
		formatString: #,0
		lineageTag: 9a25d957-702c-4579-a7cb-f657401f7983

